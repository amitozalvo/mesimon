{"event": "PostToolUse", "kind": "hook", "payload": {"cwd": "{cwd}", "duration_ms": 19, "effort": {"level": "low"}, "hook_event_name": "PostToolUse", "mcp_server": {"name": "mesimon", "source": "dynamic"}, "permission_mode": "auto", "prompt_id": "0d2df9d1-5809-443e-a77f-c63f46498290", "scratchpad_dir": "/private/tmp/claude-501/~--local-state-mesimon-ce56cdc93590caf7-worktrees-T-12-t-1014-ep1-a-person-s-words/{session}/scratchpad", "session_id": "{session}", "tool_input": {}, "tool_name": "mcp__mesimon__get_ticket", "tool_response": [{"text": "{\n  \"key\": \"T-12\",\n  \"key_about\": \"Words to the person about this ticket call it \\\"this ticket\\\", not its key: the person reads this session beside it, in its pane, its page and its notes, where the key is one more lookup. A key is for naming another ticket.\",\n  \"title\": \"T-1014 EP1 · a person's words reach an agent the moment it wakes: do the steps below\",\n  \"column\": \"IN PROGRESS\",\n  \"workspace\": \"worktree\",\n  \"branch\": \"msmn/T-12-t-1014-ep1-a-person-s-words\",\n  \"merge_state\": \"clean\",\n  \"merge\": {\n    \"by\": \"crown\",\n    \"why\": \"out of the train (t)\"\n  },\n  \"held\": \"person\",\n  \"worktree_init\": {\n    \"script\": \".mesimon-worktree-init.sh\",\n    \"present\": true,\n    \"about\": \"A script at the repository's root, run once in each new worktree before its agent starts: read from the checkout, run in the worktree through the person's login-shell environment, with the checkout's path in mesimon_checkout and the worktree's in mesimon_worktree (uppercase, as every mesimon variable). Where a build cache is seeded or dependencies installed so the worktree starts warm; absent, nothing runs, and a failure is reported while the agent starts anyway.\",\n    \"last\": \"ok ∙ 0 s\"\n  },\n  \"allowed_columns\": [\n    \"TODO\",\n    \"RIG MANUAL\",\n    \"REVIEW\",\n    \"DONE\"\n  ],\n  \"automove\": {\n    \"on_working\": null,\n    \"on_done\": \"REVIEW\"\n  },\n  \"tags\": [],\n  \"allowed_tags\": [\n    {\n      \"name\": \"BUG\",\n      \"group\": 1\n    },\n    {\n      \"name\": \"FEATURE\",\n      \"group\": 1\n    },\n    {\n      \"name\": \"CHANGE\",\n      \"group\": 1\n    }\n  ],\n  \"board_version\": 26,\n  \"description\": \"Reply with the single word done and end your turn. Read no file and run no command.\",\n  \"notes\": [\n    {\n      \"id\": \"01M5VYWCXN9VFZZ4W0G4N5PV61\",\n      \"name\": \"Reply with the single word done and end your turn. Read no file and run no comma\",\n      \"by\": \"local\",\n      \"edited_at\": \"@1793013461\"\n    },\n    {\n      \"id\": \"01M5VYWCY3GS99ZG2X13TSGV5Z\",\n      \"name\": \"EP1: what the rig checks\",\n      \"by\": \"local\",\n      \"edited_at\": \"@1793013461\"\n    }\n  ],\n  \"summary\": {\n    \"about\": \"A note section headed `Summary` is what the ticket's card shows: a `- [ ] …` item is a box the person ticks on the board, counted as progress, and an open box reads as work left. Only the boxes reach the card; any other line there stays the note's. A pull request's address on a plain line there (no box) names it as the ticket's: one its work opened in another repository, or one it reviewed; the board reads it from the forge and shows it beside the ticket's own.\"\n  },\n  \"crowned\": false,\n  \"under_crown\": \"The board's crown, the agent coordinating this board from another ticket, started this session. Under a crown the merge is the board's: the merge train lands a finished branch, else the crown does, and the board asks for its rebase and closes the ticket. The board reads a background task or monitor still running after a turn as unfinished work: the branch is not merged behind it, and the crown is told. Words in the pane reach no one: raise_hand on this ticket wakes the crown and lights the card.\",\n  \"state\": {\n    \"state\": \"working\",\n    \"since_secs\": 8\n  },\n  \"seen\": \"a54362a8bd8275bb\"\n}", "type": "text"}], "tool_use_id": "toolu_01XAEbS8AH2bK3WHwFSztxtU", "transcript_path": "{transcript}"}, "reason": null, "session": "{session}", "t": 9388}
