{
  "schema": 1,
  "id": "restart-in-compaction",
  "title": "A daemon restarted inside a quiet compaction reads none of its frames as a turn",
  "provenance": {
    "kind": "capture_derived",
    "capture": "T-894 review: T-728's feed (PreCompact auto, two SubagentStop, SessionStart compact, PostCompact auto, 122 s) with a restart after the PreCompact",
    "claude_version": "2.1.296",
    "note": "The restart's machine starts with no window and reads the tail at Low; before the fix the helper SubagentStops promoted that Idle to Running (Medium moves a ticket) and the PostCompact affirmed it High with no Stop to follow. Virtual timing."
  },
  "initial": {
    "state": "idle",
    "stop_reason": "end_turn"
  },
  "confidence": "high",
  "column": "REVIEW",
  "steps": [
