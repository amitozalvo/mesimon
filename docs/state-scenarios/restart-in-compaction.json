      "input": {"source": "hook", "event": "SessionStart", "payload": {"source": "compact"}},
      "expect": {"state": {"state": "idle", "stop_reason": "end_turn"}, "column": "REVIEW", "compacting": false}
    },
    {
      "at_ms": 130000,
      "input": {"source": "tick"},
      "expect": {"state": {"state": "idle", "stop_reason": "end_turn"}, "column": "REVIEW", "confidence": "low"}
    },
    {
      "at_ms": 200000,
