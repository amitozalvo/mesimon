      "input": {"source": "hook", "event": "PreCompact", "payload": {"trigger": "auto"}},
      "expect": {"state": {"state": "idle", "stop_reason": "end_turn"}, "column": "REVIEW", "compacting": true}
    },
    {
      "at_ms": 1000,
      "input": {"source": "restart"},
      "expect": {"state": {"state": "unknown", "reason": "no_signal"}, "column": "REVIEW", "confidence": "low", "compacting": false}
    },
    {
      "at_ms": 1100,
      "input": {"source": "transcript", "record": {"uuid": "reply", "type": "assistant", "message": {"stop_reason": "end_turn", "content": [{"type": "text", "text": "done"}]}}},
      "expect": {"state": {"state": "idle", "stop_reason": "end_turn"}, "column": "REVIEW", "confidence": "low", "compacting": false}
    },
    {
      "at_ms": 3000,
      "input": {"source": "tick"},
      "expect": {"state": {"state": "idle", "stop_reason": "end_turn"}, "column": "REVIEW", "confidence": "low", "compacting": false}
    },
    {
      "at_ms": 60000,
      "input": {"source": "hook", "event": "SessionStart", "payload": {"source": "compact"}},
      "expect": {"state": {"state": "idle", "stop_reason": "end_turn"}, "column": "REVIEW", "compacting": true}
    },
    {
      "at_ms": 60100,
      "input": {"source": "hook", "event": "SubagentStop", "payload": {"agent_type": ""}},
      "expect": {"state": {"state": "idle", "stop_reason": "end_turn"}, "column": "REVIEW", "confidence": "low", "compacting": true}
    },
    {
      "at_ms": 60200,
      "input": {"source": "hook", "event": "SubagentStop", "payload": {"agent_type": ""}},
      "expect": {"state": {"state": "idle", "stop_reason": "end_turn"}, "column": "REVIEW", "confidence": "low", "compacting": true}
    },
    {
      "at_ms": 122000,
      "input": {"source": "hook", "event": "PostCompact", "payload": {"trigger": "auto"}},
      "expect": {"state": {"state": "idle", "stop_reason": "end_turn"}, "column": "REVIEW", "confidence": "low", "compacting": false}
