{
  "schema": 1,
  "id": "rate-limit",
  "title": "Rate limit has a longer recovery settle",
  "provenance": {
    "kind": "synthetic_regression",
    "source": "docs/claude-state-lab.md"
  },
  "initial": {
    "state": "running"
  },
  "confidence": "high",
  "column": "IN PROGRESS",
  "steps": [
    {
      "at_ms": 100,
      "input": {
        "source": "hook",
        "event": "StopFailure",
        "payload": {
          "error": "rate_limit"
        }
      },
      "expect": {
        "state": {
          "state": "throttled"
        },
        "column": "IN PROGRESS"
      }
    },
    {
      "at_ms": 200,
      "input": {
        "source": "hook",
        "event": "UserPromptSubmit",
        "payload": {}
      },
      "expect": {
        "state": {
          "state": "throttled"
        },
        "column": "IN PROGRESS",
        "pending": true
      }
    },
    {
      "at_ms": 5199,
      "input": {
        "source": "tick"
      },
      "expect": {
        "state": {
          "state": "throttled"
        },
        "column": "IN PROGRESS"
      }
    },
    {
      "at_ms": 5200,
      "input": {
        "source": "tick"
      },
      "expect": {
        "state": {
          "state": "running"
        },
        "column": "IN PROGRESS"
      }
    }
  ]
}
