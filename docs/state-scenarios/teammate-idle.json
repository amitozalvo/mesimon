{
  "schema": 1,
  "id": "teammate-idle",
  "title": "An idle teammate does not hold the finished lead",
  "provenance": {
    "kind": "synthetic_regression",
    "source": "docs/claude-state-lab.md"
  },
  "initial": {
    "state": "running"
  },
  "confidence": "high",
  "column": "IN PROGRESS",
  "steps": [
    {
      "at_ms": 100,
      "input": {
        "source": "hook",
        "event": "TeammateIdle",
        "payload": {
          "teammate_name": "reviewer"
        }
      },
      "expect": {
        "state": {
          "state": "running"
        },
        "column": "IN PROGRESS"
      }
    },
    {
      "at_ms": 200,
      "input": {
        "source": "hook",
        "event": "Stop",
        "payload": {
          "background_tasks": [
            {
              "type": "teammate"
            }
          ]
        }
      },
      "expect": {
        "state": {
          "state": "running"
        },
        "column": "IN PROGRESS"
      }
    },
    {
      "at_ms": 1700,
      "input": {
        "source": "tick"
      },
      "expect": {
        "state": {
          "state": "idle",
          "stop_reason": "end_turn"
        },
        "column": "REVIEW"
      }
    }
  ]
}
