{
  "schema": 1,
  "id": "parallel-tools",
  "title": "One tool result cannot close its still-running sibling",
  "provenance": {
    "kind": "synthetic_regression",
    "source": "docs/claude-state-lab.md"
  },
  "initial": {
    "state": "unknown",
    "reason": "no_signal"
  },
  "confidence": "low",
  "column": "IN PROGRESS",
  "steps": [
    {
      "at_ms": 100,
      "input": {
        "source": "transcript",
        "record": {
          "uuid": "calls",
          "type": "assistant",
          "message": {
            "content": [
              {
                "type": "tool_use",
                "id": "tool1",
                "name": "Bash"
              },
              {
                "type": "tool_use",
                "id": "tool2",
                "name": "Bash"
              }
            ]
          }
        }
      },
      "expect": {
        "state": {
          "state": "running"
        },
        "column": "IN PROGRESS",
        "confidence": "low"
      }
    },
    {
      "at_ms": 200,
      "input": {
        "source": "transcript",
        "record": {
          "uuid": "result",
          "type": "user",
          "message": {
            "content": [
              {
                "type": "tool_result",
                "tool_use_id": "tool1",
                "content": "done"
              }
            ]
          }
        }
      },
      "expect": {
        "state": {
          "state": "running"
        },
        "column": "IN PROGRESS"
      }
    },
    {
      "at_ms": 60000,
      "input": {
        "source": "transcript_quiet"
      },
      "expect": {
        "state": {
          "state": "running"
        },
        "column": "IN PROGRESS"
      }
    },
    {
      "at_ms": 62000,
      "input": {
        "source": "tick"
      },
      "expect": {
        "state": {
          "state": "running"
        },
        "column": "IN PROGRESS"
      }
    }
  ]
}
