{
  "schema": 1,
  "id": "dormant-monitor",
  "title": "A live monitor parks without active work",
  "provenance": {
    "kind": "synthetic_regression",
    "source": "docs/claude-state-lab.md"
  },
  "initial": {
    "state": "running"
  },
  "confidence": "high",
  "column": "IN PROGRESS",
  "steps": [
    {
      "at_ms": 100,
      "input": {
        "source": "hook",
        "event": "Stop",
        "payload": {
          "background_tasks": [
            {
              "type": "monitor",
              "status": "running"
            }
          ]
        }
      },
      "expect": {
        "state": {
          "state": "running"
        },
        "column": "IN PROGRESS"
      }
    },
    {
      "at_ms": 1600,
      "input": {
        "source": "tick"
      },
      "expect": {
        "state": {
          "state": "idle",
          "stop_reason": "monitoring"
        },
        "column": "IN PROGRESS"
      }
    }
  ]
}
