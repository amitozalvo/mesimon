{
  "schema": 1,
  "id": "transcript-interrupt",
  "title": "An explicit interrupt never moves to REVIEW",
  "provenance": {
    "kind": "synthetic_regression",
    "source": "docs/claude-state-lab.md"
  },
  "initial": {
    "state": "running"
  },
  "confidence": "high",
  "column": "IN PROGRESS",
  "steps": [
    {
      "at_ms": 100,
      "input": {
        "source": "transcript",
        "record": {
          "uuid": "interrupt",
          "type": "user",
          "interruptedMessageId": "reply",
          "message": {
            "content": "[Request interrupted by user]"
          }
        }
      },
      "expect": {
        "state": {
          "state": "running"
        },
        "column": "IN PROGRESS"
      }
    },
    {
      "at_ms": 1600,
      "input": {
        "source": "tick"
      },
      "expect": {
        "state": {
          "state": "idle",
          "stop_reason": "interrupted"
        },
        "column": "IN PROGRESS",
        "confidence": "low"
      }
    }
  ]
}
