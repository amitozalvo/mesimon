{
  "schema": 1,
  "id": "mixed-text-tool",
  "title": "Text accompanying a tool call cannot hide a long-running tool",
  "provenance": {
    "kind": "synthetic_regression",
    "source": "docs/claude-state-lab.md"
  },
  "initial": {
    "state": "unknown",
    "reason": "no_signal"
  },
  "confidence": "low",
  "column": "IN PROGRESS",
  "steps": [
    {
      "at_ms": 100,
      "input": {
        "source": "transcript",
        "record": {
          "uuid": "call",
          "type": "assistant",
          "message": {
            "stop_reason": "tool_use",
            "content": [
              {
                "type": "text",
                "text": "Running the test now"
              },
              {
                "type": "tool_use",
                "id": "tool1",
                "name": "Bash",
                "input": {
                  "command": "sleep 90"
                }
              }
            ]
          }
        }
      },
      "expect": {
        "state": {
          "state": "running"
        },
        "column": "IN PROGRESS",
        "confidence": "low"
      }
    },
    {
      "at_ms": 60000,
      "input": {
        "source": "transcript_quiet"
      },
      "expect": {
        "state": {
          "state": "running"
        },
        "column": "IN PROGRESS"
      }
    },
    {
      "at_ms": 62000,
      "input": {
        "source": "tick"
      },
      "expect": {
        "state": {
          "state": "running"
        },
        "column": "IN PROGRESS"
      }
    }
  ]
}
