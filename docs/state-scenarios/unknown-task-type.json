{
  "schema": 1,
  "id": "unknown-task-type",
  "title": "Unknown background task types conservatively hold the turn",
  "provenance": {
    "kind": "synthetic_regression",
    "source": "docs/claude-state-lab.md"
  },
  "initial": {
    "state": "running"
  },
  "confidence": "high",
  "column": "IN PROGRESS",
  "steps": [
    {
      "at_ms": 100,
      "input": {
        "source": "hook",
        "event": "Stop",
        "payload": {
          "background_tasks": [
            {
              "type": "future_task"
            }
          ]
        }
      },
      "expect": {
        "state": {
          "state": "running"
        },
        "column": "IN PROGRESS"
      }
    },
    {
      "at_ms": 1600,
      "input": {
        "source": "tick"
      },
      "expect": {
        "state": {
          "state": "idle",
          "stop_reason": "background"
        },
        "column": "IN PROGRESS"
      }
    }
  ]
}
