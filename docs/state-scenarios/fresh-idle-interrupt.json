{
  "schema": 1,
  "id": "fresh-idle-interrupt",
  "title": "Qualified idle without completion uses the existing interruption inference",
  "provenance": {
    "kind": "synthetic_regression",
    "source": "docs/claude-state-lab.md"
  },
  "initial": {
    "state": "running"
  },
  "confidence": "high",
  "column": "IN PROGRESS",
  "steps": [
    {
      "at_ms": 100,
      "input": {
        "source": "status_idle",
        "turn_done": false
      },
      "expect": {
        "state": {
          "state": "running"
        },
        "column": "IN PROGRESS"
      }
    },
    {
      "at_ms": 1600,
      "input": {
        "source": "tick"
      },
      "expect": {
        "state": {
          "state": "idle",
          "stop_reason": "interrupted"
        },
        "column": "IN PROGRESS",
        "confidence": "medium"
      }
    }
  ]
}
